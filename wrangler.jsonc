{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "json-workbench-extension",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "json-workbench-extension.xiaosang.cc",
      "custom_domain": true
    }
  ]
}
